# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Only ${CORS_ALLOW_ORIGIN}, ${S3_BUCKET_HLS}, ${S3_BUCKET_PUBLIC}, ${PLAYBACK_SIGNING_KEY} are substituted.

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# Playlists and subtitle indexes are VOD but may be rewritten when a video is reprocessed: 5 minutes.
# Segments and init files never change once published (the pipeline matches these values).
map $uri $media_cache_control {
    default                    "public, max-age=60";
    ~*\.(m3u8|vtt)$            "public, max-age=300";
    ~*\.(ts|m4s|mp4|aac|m4a)$  "public, max-age=31536000, immutable";
    ~*\.(jpg|jpeg)$            "public, max-age=86400";
}

upstream web_upstream   { server web:3000;   keepalive 16; }
upstream api_upstream   { server api:8080;   keepalive 16; }
upstream s3_upstream    { server seaweedfs:8333; keepalive 16; }
# The object store's file API. It has no authentication, so it is reachable ONLY inside the Docker
# network, and only through the signed location below. (Cloud: the CDN fetches from R2/S3 instead.)
upstream filer_upstream { server seaweedfs:8888; keepalive 16; }

server {
    listen 80;
    server_name _;
    server_tokens off;

    set $cors_origin "${CORS_ALLOW_ORIGIN}";

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # /api/foo -> api:8080/foo (prefix stripped by the trailing slash).
    location /api/ {
        proxy_pass http://api_upstream/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # CDN stand-in for HLS, protected by expiring signed URLs (docs/playback.md).
    #   /hls/<token>/<expires>/<assetId>/<file>
    # The token is base64url(md5("<expires><assetId> <key>")): it covers one asset until the expiry, so the
    # playlist, every rendition, every segment and the subtitles of that asset all pass with the same
    # prefix, because relative URLs inside the playlists inherit it. Anything else gets 403.
    location ~ "^/hls/(?<sl_token>[A-Za-z0-9_-]{20,30})/(?<sl_expires>[0-9]{9,12})/(?<sl_asset>[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/(?<sl_file>[A-Za-z0-9_][A-Za-z0-9_./-]*\.(?:m3u8|m4s|mp4|vtt|ts|aac))$" {
        secure_link $sl_token,$sl_expires;
        secure_link_md5 "$secure_link_expires$sl_asset ${PLAYBACK_SIGNING_KEY}";
        if ($secure_link = "")  { return 403; }   # wrong or tampered token
        if ($secure_link = "0") { return 410; }   # right token, but expired: ask the API for a new URL
        if ($sl_file ~ "\.\.") { return 403; }   # no path tricks

        include /etc/nginx/snippets/media.conf;
        proxy_set_header Host seaweedfs:8888;
        proxy_pass http://filer_upstream/buckets/${S3_BUCKET_HLS}/$sl_asset/$sl_file;
    }
    location /hls/ { return 403; }

    # Anonymous-read bucket (posters, thumbnails).
    location /public/ {
        include /etc/nginx/snippets/media.conf;
        proxy_set_header Host seaweedfs:8333;
        proxy_pass http://s3_upstream/${S3_BUCKET_PUBLIC}/;
    }

    # Everything else is the Next.js app (WebSocket upgrade needed for dev HMR).
    location / {
        proxy_pass http://web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
