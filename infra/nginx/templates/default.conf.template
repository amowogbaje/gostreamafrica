# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Only ${CORS_ALLOW_ORIGIN}, ${S3_BUCKET_HLS}, ${S3_BUCKET_PUBLIC} are substituted.

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# Short TTL for playlists (they change), long for immutable segments.
map $uri $media_cache_control {
    default                    "public, max-age=60";
    ~*\.m3u8$                  "public, max-age=2";
    ~*\.(ts|m4s|mp4|aac|m4a)$  "public, max-age=31536000, immutable";
}

upstream web_upstream   { server web:3000;   keepalive 16; }
upstream api_upstream   { server api:8080;   keepalive 16; }
upstream minio_upstream { server minio:9000; keepalive 16; }

server {
    listen 80;
    server_name _;
    server_tokens off;

    set $cors_origin "${CORS_ALLOW_ORIGIN}";

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # /api/foo -> api:8080/foo (prefix stripped by the trailing slash).
    location /api/ {
        proxy_pass http://api_upstream/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # CDN stand-in for HLS. media-hls is private: unsigned requests get 403 from
    # MinIO. Signed expiring URLs are designed in a later step.
    location /hls/ {
        include /etc/nginx/snippets/media.conf;
        proxy_pass http://minio_upstream/${S3_BUCKET_HLS}/;
    }

    # Anonymous-read bucket (posters, thumbnails).
    location /public/ {
        include /etc/nginx/snippets/media.conf;
        proxy_pass http://minio_upstream/${S3_BUCKET_PUBLIC}/;
    }

    # Everything else is the Next.js app (WebSocket upgrade needed for dev HMR).
    location / {
        proxy_pass http://web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
