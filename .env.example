# StreamAfrica local environment. Copy to .env (make up does this for you).
# Keep passwords URL-safe (letters, digits, - and _ only): they are embedded in URLs.
# NEVER put real secrets in this file. It is committed.

# ---------- Global ----------
APP_ENV=local
# 127.0.0.1 = only this machine. Use 0.0.0.0 to test from a phone on your LAN.
BIND_ADDR=127.0.0.1

# ---------- Postgres ----------
POSTGRES_USER=streamafrica
POSTGRES_PASSWORD=streamafrica_local_pw
POSTGRES_DB=streamafrica
POSTGRES_HOST_PORT=5432

# ---------- Redis ----------
REDIS_PASSWORD=redis_local_pw
REDIS_HOST_PORT=6379

# ---------- MinIO (S3-compatible storage) ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_local_pw
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
# Third-party mirrors of the last MinIO images (official ones were deleted). Local dev only.
MINIO_IMAGE=scnd/minio-mirror:RELEASE.2025-09-07T16-13-09Z
MC_IMAGE=scnd/mc-mirror:RELEASE.2025-02-04T04-57-50Z
S3_BUCKET_RAW=media-raw
S3_BUCKET_HLS=media-hls
S3_BUCKET_PUBLIC=media-public

# ---------- Mailpit (local SMTP catcher) ----------
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025

# ---------- API (Go) ----------
API_HOST_PORT=8080
API_LOG_LEVEL=debug
DB_MAX_CONNS=10
# Reverse proxies in front of the API (nginx locally = 1). Used for client IPs in rate limits and
# lockout. Too low merges users behind a proxy; too high lets clients forge X-Forwarded-For.
TRUSTED_PROXY_HOPS=1

# ---------- Auth ----------
# REQUIRED. At least 32 characters. This example value is refused when APP_ENV is not "local".
# Generate a real one with: openssl rand -base64 48
AUTH_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=30
AUTH_REFRESH_ABSOLUTE_DAYS=90
# Path the refresh cookie is sent to, as the BROWSER sees it (behind nginx: /api/v1/auth).
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
# Browser origins allowed to use the refresh cookie (comma separated).
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8088
# Base URL used in email links.
WEB_BASE_URL=http://localhost:8088
# argon2id cost. Raise on stronger servers; old hashes are upgraded on next login.
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME=2
AUTH_ARGON2_PARALLELISM=1

# ---------- Email (Mailpit locally; a real provider elsewhere) ----------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="StreamAfrica <no-reply@streamafrica.local>"
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_REQUIRE_TLS=true      # defaults to true outside APP_ENV=local

# ---------- Catalog cache ----------
CATALOG_HOME_TTL_SECONDS=300
CATALOG_GENRES_TTL_SECONDS=600

# ---------- Worker (Go + FFmpeg) ----------
WORKER_LOG_LEVEL=debug

# ---------- Web (Next.js) ----------
WEB_HOST_PORT=3000
# Used by the browser (goes through nginx so there is no CORS to configure).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8088/api
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:8088

# ---------- Nginx (CDN stand-in) ----------
NGINX_HOST_PORT=8088
# Media responses only (no credentials). Tighten in non-local environments.
CORS_ALLOW_ORIGIN=*

# ---------- Reserved for later phases (not read by any code yet) ----------
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=
# MEDIA_URL_SIGNING_SECRET=
