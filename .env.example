# StreamAfrica local environment. Copy to .env (make up does this for you).
# Keep passwords URL-safe (letters, digits, - and _ only): they are embedded in URLs.
# NEVER put real secrets in this file. It is committed.

# ---------- Global ----------
APP_ENV=local
# 127.0.0.1 = only this machine. Use 0.0.0.0 to test from a phone on your LAN.
BIND_ADDR=127.0.0.1

# ---------- Host ports (the ONLY place to change ports) ----------
# Left side of each docker port mapping. Container-internal ports never change.
# Keep this block ABOVE the URLs below: they are built from these values, and
# .env is read top to bottom (docker compose and the make/shell scripts).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
S3_HOST_PORT=8333
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025
API_HOST_PORT=8080
WEB_HOST_PORT=3000
NGINX_HOST_PORT=8088

# ---------- Postgres ----------
POSTGRES_USER=streamafrica
POSTGRES_PASSWORD=streamafrica_local_pw
POSTGRES_DB=streamafrica

# ---------- Redis ----------
REDIS_PASSWORD=redis_local_pw

# ---------- Object storage: SeaweedFS (S3-compatible, local development only) ----------
# The application speaks plain S3 (docs/adr/0006). Staging/production point the same variables at R2 or S3.
# Pinned image. Verify it exists with: docker pull chrislusf/seaweedfs:4.51
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.51
# The app's S3 identity. Without a config file SeaweedFS accepts ANY key, so these are rendered
# into its identities file at start (infra/seaweedfs/entrypoint.sh). Letters, digits, - and _ only.
# After changing them: docker compose up -d --force-recreate seaweedfs
S3_ACCESS_KEY=streamafrica_local_key
S3_SECRET_KEY=streamafrica_local_secret_pw
S3_REGION=us-east-1
S3_BUCKET_RAW=media-raw
S3_BUCKET_HLS=media-hls
S3_BUCKET_PUBLIC=media-public
# What the BROWSER uses to reach the store (presigned URLs are signed for this host).
S3_PUBLIC_ENDPOINT=http://localhost:${S3_HOST_PORT}
# Browser origins allowed to upload straight to the store (CORS). Same origins as the web app.
S3_ALLOWED_ORIGINS=http://localhost:${WEB_HOST_PORT},http://localhost:${NGINX_HOST_PORT}

# ---------- Mailpit (local SMTP catcher; ports are in the Host ports block above) ----------

# ---------- API (Go) ----------
API_LOG_LEVEL=debug
DB_MAX_CONNS=10
# Reverse proxies in front of the API (nginx locally = 1). Used for client IPs in rate limits and
# lockout. Too low merges users behind a proxy; too high lets clients forge X-Forwarded-For.
TRUSTED_PROXY_HOPS=1
# Serve the interactive API docs (Swagger UI) at /docs/ (through nginx: /api/docs/).
# Defaults to true only when APP_ENV=local; set true to expose them elsewhere on purpose.
# API_DOCS_ENABLED=true

# ---------- Auth ----------
# REQUIRED. At least 32 characters. This example value is refused when APP_ENV is not "local".
# Generate a real one with: openssl rand -base64 48
AUTH_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=30
AUTH_REFRESH_ABSOLUTE_DAYS=90
# Path the refresh cookie is sent to, as the BROWSER sees it (behind nginx: /api/v1/auth).
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
# Browser origins allowed to use the refresh cookie (comma separated).
AUTH_ALLOWED_ORIGINS=http://localhost:${WEB_HOST_PORT},http://localhost:${NGINX_HOST_PORT}
# Base URL used in email links.
WEB_BASE_URL=http://localhost:${NGINX_HOST_PORT}
# argon2id cost. Raise on stronger servers; old hashes are upgraded on next login.
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME=2
AUTH_ARGON2_PARALLELISM=1

# ---------- Email (Mailpit locally; a real provider elsewhere) ----------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="StreamAfrica <no-reply@streamafrica.local>"
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_REQUIRE_TLS=true      # defaults to true outside APP_ENV=local

# ---------- Catalog cache ----------
CATALOG_HOME_TTL_SECONDS=300
CATALOG_GENRES_TTL_SECONDS=600

# ---------- Worker (Go + FFmpeg) ----------
WORKER_LOG_LEVEL=debug

# ---------- Web (Next.js) ----------
# Used by the browser (goes through nginx so there is no CORS to configure).
# Built from NGINX_HOST_PORT above: do not hard-code a port here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:${NGINX_HOST_PORT}/api
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:${NGINX_HOST_PORT}

# ---------- Nginx (CDN stand-in) ----------
# Media responses only (no credentials). Tighten in non-local environments.
CORS_ALLOW_ORIGIN=*

# ---------- Reserved for later phases (not read by any code yet) ----------
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=
# MEDIA_URL_SIGNING_SECRET=

# ---------- Creator uploads (Phase 2) ----------
# 8 GiB default limit; parts of 64 MiB (an 8 GiB file is 128 parts). S3 allows at most 10000 parts.
UPLOAD_MAX_BYTES=8589934592
UPLOAD_PART_BYTES=67108864
UPLOAD_MAX_ACTIVE_PER_CREATOR=3
UPLOAD_DAILY_BYTES_PER_CREATOR=34359738368
